DOMAIN=gaeb.example.de
MAX_UPLOAD_BYTES=2097152
PAID_MAX_UPLOAD_BYTES=26214400
RETENTION_HOURS=24
DIAGNOSTIC_RETENTION_DAYS=30
# Langer, zufälliger Schlüssel für pseudonymisierte Gratisnutzungs-Nachweise.
FREE_TRIAL_HASH_SECRET=
RUST_LOG=info

# SMTP für fehlertolerante Exporte per E-Mail
SMTP_HOST=mail.example.de
SMTP_PORT=587
SMTP_USERNAME=gaeb@example.de
SMTP_PASSWORD=change-me
SMTP_FROM=gaeb@example.de

# Optionales Tracking. Ohne Wert wird der jeweilige Dienst nicht geladen und
# nicht im Cookie-Banner angezeigt.
GOOGLE_TAG_MANAGER_ID=GTM-TF86FD6Z
GOOGLE_ANALYTICS_ID=
GOOGLE_ADS_ID=AW-18376784283
GOOGLE_ADS_PURCHASE_SEND_TO=
META_PIXEL_ID=
KLICKTIPP_PIXEL_URL=

# Erhöhen, wenn alle Besucher erneut nach ihrer Einwilligung gefragt werden sollen.
COOKIE_CONSENT_VERSION=3

# Stripe zunächst ausschließlich mit Testschlüsseln konfigurieren.
# Preise und Währung werden direkt aus den Stripe-Price-Objekten gelesen.
PUBLIC_BASE_URL=https://gaeb.example.de
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional; derzeit ist der Einzelkauf auf der Oberfläche deaktiviert.
STRIPE_SINGLE_PRICE_ID=
STRIPE_PRO_PRICE_ID=
# Optional: Sobald gesetzt, wird das Jahresabo automatisch angezeigt.
STRIPE_PRO_YEARLY_PRICE_ID=
OFFER_BANNER_TEXT=

# Optionaler interner Adminbereich. Einen langen zufälligen Wert verwenden.
ADMIN_TOKEN=
# Kommagetrennte, mindestens 32 Zeichen lange Schlüssel für /api/v1/*.
INTEGRATION_API_KEYS=
# Testlabor nur während interner PDF-Stapeltests einschalten.
TEST_LAB_ENABLED=false
